{
  "appId": "tn.atlas.maps",
  "appName": "Atlas",
  "webDir": "web",
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0f1117"
  },
  "server": {
    "androidScheme": "http",
    "cleartext": true,
    "hostname": "localhost"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#0f1117"
    },
    "Filesystem": {
      "directory": "DATA"
    }
  }
}