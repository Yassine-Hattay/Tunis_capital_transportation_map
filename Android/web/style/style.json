    { "id": "streets-trunk", "type": "line", "source": "omt", "source-layer": "streets", "filter": ["==", "kind", "trunk"], "minzoom": 6, "paint": { "line-color": "#888888", "line-width": { "base": 1.2, "stops": [[6, 0.5], [12, 2], [16, 6]] } } },
    { "id": "streets-primary", "type": "line", "source": "omt", "source-layer": "streets", "filter": ["==", "kind", "primary"], "minzoom": 8, "paint": { "line-color": "#888888", "line-width": { "base": 1.2, "stops": [[8, 0.5], [12, 2], [16, 5]] } } },
    { "id": "streets-secondary", "type": "line", "source": "omt", "source-layer": "streets", "filter": ["==", "kind", "secondary"], "minzoom": 9, "paint": { "line-color": "#888888", "line-width": { "base": 1.2, "stops": [[9, 0.5], [14, 2], [16, 4]] } } },
