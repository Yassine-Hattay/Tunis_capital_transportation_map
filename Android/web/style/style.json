    { "id": "land-industrial", "type": "fill", "source": "omt", "source-layer": "land", "filter": ["in", "kind", "industrial", "commercial", "retail"], "minzoom": 10, "paint": { "fill-color": "#e8e0d8", "fill-opacity": 0.3 } },

