{
  "version": 8,
  "name": "Shortbread Tunisia — Enhanced",
  "metadata": {
    "mapbox:autocomposite": false,
    "mapbox:type": "template",
    "openmaptiles:version": "shortbread"
  },
  "center": [10.1815, 36.8065],
  "zoom": 12,
  "bearing": 0,
  "pitch": 0,
  "sources": {
    "omt": {
      "type": "vector",
      "url": ""
    }
  },
  "sprite": "../sprites/sprites",
  "glyphs": "./font/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f8f4f0" } },

    { "id": "ocean", "type": "fill", "source": "omt", "source-layer": "ocean", "paint": { "fill-color": "#a0c8f0" } },
    { "id": "water_polygons", "type": "fill", "source": "omt", "source-layer": "water_polygons", "paint": { "fill-color": "#a0c8f0", "fill-opacity": 0.9 } },
    { "id": "water_polygons_labels", "type": "symbol", "source": "omt", "source-layer": "water_polygons_labels", "minzoom": 10, "layout": { "text-field": "{name}", "text-font": ["Noto Sans Italic"], "text-size": { "base": 1.2, "stops": [[10, 10], [14, 14]] }, "text-transform": "lowercase" }, "paint": { "text-color": "#4a6a8a", "text-halo-color": "#fff", "text-halo-width": 1 } },
    { "id": "water_lines", "type": "line", "source": "omt", "source-layer": "water_lines", "paint": { "line-color": "#888888", "line-width": { "base": 1.2, "stops": [[10, 0.8], [14, 2], [20, 6]] } } },
    { "id": "water_lines_labels", "type": "symbol", "source": "omt", "source-layer": "water_lines_labels", "minzoom": 12, "layout": { "symbol-placement": "line", "text-field": "{name}", "text-font": ["Noto Sans Italic"], "text-size": 11 }, "paint": { "text-color": "#4a6a8a", "text-halo-color": "#fff", "text-halo-width": 1 } },
    { "id": "dam_lines", "type": "line", "source": "omt", "source-layer": "dam_lines", "minzoom": 12, "paint": { "line-color": "#888888", "line-width": 2, "line-dasharray": [4, 2] } },
    { "id": "pier_lines", "type": "line", "source": "omt", "source-layer": "pier_lines", "minzoom": 12, "paint": { "line-color": "#888888", "line-width": 1 } },

    { "id": "land", "type": "fill", "source": "omt", "source-layer": "land", "filter": ["!in", "kind", "forest", "park", "village_green", "grass", "meadow", "sand", "beach", "industrial", "residential", "cemetery", "orchard", "vineyard", "wetland", "scrub", "heath"], "paint": { "fill-color": "#f8f4f0" } },
    { "id": "land-forest", "type": "fill", "source": "omt", "source-layer": "land", "filter": ["==", "kind", "forest"], "minzoom": 7, "paint": { "fill-color": "#c8e0b8", "fill-opacity": { "stops": [[7, 0.3], [10, 0.7]] } } },
    { "id": "land-park", "type": "fill", "source": "omt", "source-layer": "land", "filter": ["in", "kind", "park", "village_green", "recreation_ground"], "minzoom": 11, "paint": { "fill-color": "#d8e8c8", "fill-opacity": { "stops": [[11, 0.4], [13, 0.8]] } } },
    { "id": "land-grass", "type": "fill", "source": "omt", "source-layer": "land", "filter": ["in", "kind", "grass", "meadow"], "minzoom": 11, "paint": { "fill-color": "#e0f0d0" } },
    { "id": "land-sand", "type": "fill", "source": "omt", "source-layer": "land", "filter": ["in", "kind", "sand", "beach"], "minzoom": 10, "paint": { "fill-color": "#f0e8d0" } },
    { "id": "land-cemetery", "type": "fill", "source": "omt", "source-layer": "land", "filter": ["==", "kind", "cemetery"], "minzoom": 13, "paint": { "fill-color": "#e0e0d0", "fill-pattern": "cemetery_11" } },
    { "id": "land-orchard", "type": "fill", "source": "omt", "source-layer": "land", "filter": ["in", "kind", "orchard", "vineyard"], "minzoom": 11, "paint": { "fill-color": "#d0e0b8", "fill-pattern": "orchard_11" } },
    { "id": "land-wetland", "type": "fill", "source": "omt", "source-layer": "land", "filter": ["in", "kind", "swamp", "bog", "marsh", "wet_meadow"], "minzoom": 11, "paint": { "fill-color": "#b8d0e0", "fill-opacity": 0.5 } },
    { "id": "land-scrub", "type": "fill", "source": "omt", "source-layer": "land", "filter": ["in", "kind", "scrub", "heath", "grassland"], "minzoom": 11, "paint": { "fill-color": "#d8e0c8" } },
