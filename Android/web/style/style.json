    { "id": "boundaries-state", "type": "line", "source": "omt", "source-layer": "boundaries", "filter": ["==", "admin_level", 4], "minzoom": 7, "paint": { "line-color": "#888888", "line-width": 1, "line-dasharray": [3, 2] } },
    { "id": "boundary_labels", "type": "symbol", "source": "omt", "source-layer": "boundary_labels", "minzoom": 3, "layout": { "text-field": "{name}", "text-font": ["Noto Sans Bold"], "text-size": { "stops": [[3, 8], [5, 12]] }, "text-transform": "uppercase", "text-anchor": "top", "text-offset": [0, 0.2] }, "paint": { "text-color": "#666", "text-halo-color": "#fff", "text-halo-width": 1.5 } },
