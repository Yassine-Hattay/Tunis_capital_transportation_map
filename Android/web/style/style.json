    { "id": "streets-pedestrian", "type": "line", "source": "omt", "source-layer": "streets", "filter": ["==", "kind", "pedestrian"], "minzoom": 13, "paint": { "line-color": "#888888", "line-width": { "base": 1.2, "stops": [[13, 0.4], [14, 1.2], [16, 3]] } } },
    { "id": "streets-track", "type": "line", "source": "omt", "source-layer": "streets", "filter": ["==", "kind", "track"], "minzoom": 13, "paint": { "line-color": "#888888", "line-width": { "base": 1.2, "stops": [[13, 0.3], [14, 0.8], [16, 2]] }, "line-dasharray": [2, 2] } },
    { "id": "streets-footway", "type": "line", "source": "omt", "source-layer": "streets", "filter": ["==", "kind", "footway"], "minzoom": 13, "paint": { "line-color": "#888888", "line-width": { "base": 1.2, "stops": [[13, 0.2], [14, 0.6], [16, 1.5]] }, "line-dasharray": [1, 2] } },
    { "id": "streets-cycleway", "type": "line", "source": "omt", "source-layer": "streets", "filter": ["==", "kind", "cycleway"], "minzoom": 13, "paint": { "line-color": "#888888", "line-width": { "base": 1.2, "stops": [[13, 0.3], [14, 0.8], [16, 2]] }, "line-dasharray": [2, 1] } },
    { "id": "streets-steps", "type": "line", "source": "omt", "source-layer": "streets", "filter": ["==", "kind", "steps"], "minzoom": 14, "paint": { "line-color": "#888888", "line-width": { "base": 1.2, "stops": [[14, 0.5], [16, 1.5]] }, "line-dasharray": [1, 1] } },
	{ "id": "streets-path", "type": "line", "source": "omt", "source-layer": "streets", "filter": ["in", "kind", "path", "footway", "cycleway"], "minzoom": 13, "paint": { "line-color": "#888888", "line-width": { "base": 1.2, "stops": [[13, 0.3], [16, 1.5]] }, "line-dasharray": [2, 2] } },
    { "id": "streets-rail", "type": "line", "source": "omt", "source-layer": "streets", "filter": ["==", "kind", "rail"], "minzoom": 8, "paint": { "line-color": "#888888", "line-width": { "base": 1.2, "stops": [[8, 0.3], [14, 1], [18, 3]] }, "line-dasharray": [3, 2] } },
	{ "id": "bridges", "type": "fill", "source": "omt", "source-layer": "bridges", "minzoom": 12, "paint": { "fill-color": "#e0e0e0", "fill-opacity": 0.3, "fill-outline-color": "#c0c0c0" } },
    { "id": "aerialways", "type": "line", "source": "omt", "source-layer": "aerialways", "minzoom": 12, "paint": { "line-color": "#888888", "line-width": 1, "line-dasharray": [2, 2] } },
    { "id": "ferries", "type": "line", "source": "omt", "source-layer": "ferries", "minzoom": 10, "paint": { "line-color": "#888888", "line-width": 1, "line-dasharray": [4, 2] } },

    { "id": "buildings", "type": "fill", "source": "omt", "source-layer": "buildings", "minzoom": 14, "paint": { "fill-color": "#e0e0e0", "fill-opacity": { "stops": [[14, 0.6], [16, 0.9]] }, "fill-outline-color": "#c0c0c0" } },
    { "id": "addresses", "type": "symbol", "source": "omt", "source-layer": "addresses", "minzoom": 16, "layout": { "text-field": "{housenumber}", "text-font": ["Noto Sans Regular"], "text-size": 9 }, "paint": { "text-color": "#666", "text-halo-color": "#fff", "text-halo-width": 1 } },

    { "id": "public_transport", "type": "symbol", "source": "omt", "source-layer": "public_transport", "minzoom": 13, "layout": { "icon-image": "{kind}_11", "text-field": "{name}", "text-font": ["Noto Sans Regular"], "text-size": 10, "text-anchor": "top", "text-offset": [0, 0.5] }, "paint": { "text-color": "#666", "text-halo-color": "#fff", "text-halo-width": 1, "icon-color": "#666" } },

    { "id": "pois", "type": "symbol", "source": "omt", "source-layer": "pois", "minzoom": 14, "layout": { "icon-image": "{kind}_11", "text-field": "{name}", "text-font": ["Noto Sans Regular"], "text-size": 11, "text-anchor": "top", "text-offset": [0, 0.6], "icon-size": { "stops": [[14, 0.8], [16, 1], [18, 1.2]] } }, "paint": { "text-color": "#666", "text-halo-color": "#fff", "text-halo-width": 1, "icon-color": "#666" } },

    { "id": "place_labels-city", "type": "symbol", "source": "omt", "source-layer": "place_labels", "filter": ["==", "kind", "city"], "layout": { "text-field": "{name}", "text-font": ["Noto Sans Bold"], "text-size": { "base": 1.2, "stops": [[7, 12], [10, 16]] }, "text-transform": "uppercase" }, "paint": { "text-color": "#333", "text-halo-color": "#fff", "text-halo-width": 1.5 } },
    { "id": "place_labels-town", "type": "symbol", "source": "omt", "source-layer": "place_labels", "filter": ["==", "kind", "town"], "minzoom": 8, "layout": { "text-field": "{name}", "text-font": ["Noto Sans Regular"], "text-size": { "base": 1.2, "stops": [[8, 11], [12, 14]] } }, "paint": { "text-color": "#444", "text-halo-color": "#fff", "text-halo-width": 1.2 } },
    { "id": "place_labels-village", "type": "symbol", "source": "omt", "source-layer": "place_labels", "filter": ["==", "kind", "village"], "minzoom": 10, "layout": { "text-field": "{name}", "text-font": ["Noto Sans Regular"], "text-size": { "base": 1.2, "stops": [[10, 10], [12, 12]] } }, "paint": { "text-color": "#555", "text-halo-color": "#fff", "text-halo-width": 1 } },

    { "id": "street_labels", "type": "symbol", "source": "omt", "source-layer": "street_labels", "minzoom": 14, "layout": { "symbol-placement": "line", "text-field": "{name}", "text-font": ["Noto Sans Regular"], "text-size": 11 }, "paint": { "text-color": "#555", "text-halo-color": "#fff", "text-halo-width": 1 } },
    { "id": "street_labels_points", "type": "symbol", "source": "omt", "source-layer": "street_labels_points", "minzoom": 12, "layout": { "text-field": "{ref}", "text-font": ["Noto Sans Bold"], "text-size": 10, "text-anchor": "center" }, "paint": { "text-color": "#fff", "text-halo-color": "#333", "text-halo-width": 1 } }
  ]
