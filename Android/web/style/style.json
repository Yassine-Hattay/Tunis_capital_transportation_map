    { "id": "sites-hospital", "type": "fill", "source": "omt", "source-layer": "sites", "filter": ["==", "kind", "hospital"], "minzoom": 14, "paint": { "fill-color": "#f0e8e8", "fill-opacity": 0.4 } },
    { "id": "sites-parking", "type": "fill", "source": "omt", "source-layer": "sites", "filter": ["in", "kind", "parking", "bicycle_parking"], "minzoom": 14, "paint": { "fill-color": "#f0f0f0", "fill-opacity": 0.6 } },
    { "id": "sites-sports", "type": "fill", "source": "omt", "source-layer": "sites", "filter": ["==", "kind", "sports_centre"], "minzoom": 14, "paint": { "fill-color": "#d8e8c8", "fill-opacity": 0.5 } },

